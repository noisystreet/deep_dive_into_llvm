#!/bin/bash
# Git Pre-Commit Hook
# 启用方式: git config --local core.hooksPath .githooks
#
# 检查内容:
#   1. C/C++ 代码格式（clang-format）
#   2. RST 文档语法（Sphinx -W 严格模式）
#   3. CJK 间距（可选告警，不阻塞提交）

EXIT_CODE=0

# ------- C/C++ 格式检查 (clang-format) -------

echo "=== Pre-Commit: 检查 C/C++ 代码格式 ==="

STAGED_CC_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cpp|h|hpp)$' || true)

if [ -n "$STAGED_CC_FILES" ]; then
    if ! command -v clang-format &>/dev/null; then
        echo "⚠  clang-format 未安装，跳过 C/C++ 格式检查。"
        echo "   安装: sudo apt install clang-format 或 pip install clang-format"
    else
        HAS_ERROR=0
        for f in $STAGED_CC_FILES; do
            staged_content=$(git show :"$f")
            formatted=$(echo "$staged_content" | clang-format --style=file 2>/dev/null)
            if [ $? -ne 0 ]; then
                echo -e "\033[0;31m✗ clang-format 解析失败: $f\033[0m"
                HAS_ERROR=1
                continue
            fi
            if [ "$staged_content" != "$formatted" ]; then
                echo -e "\033[0;31m✗ 格式错误: $f\033[0m"
                diff -u <(echo "$staged_content") <(echo "$formatted") 2>/dev/null | head -40
                echo -e "\033[1;33m  运行 clang-format -i $f 自动修复\033[0m"
                HAS_ERROR=1
            fi
        done
        if [ $HAS_ERROR -ne 0 ]; then
            EXIT_CODE=1
        else
            echo -e "\033[0;32m✓ 所有 C/C++ 文件格式正确\033[0m"
        fi
    fi
else
    echo -e "\033[0;32m✓ 没有 C/C++ 文件需要检查\033[0m"
fi

# ------- RST 文档语法检查 (Sphinx -W 严格模式) -------

echo "=== Pre-Commit: 检查 RST 文档语法 ==="

RST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.rst$' || true)

if [ -n "$RST_FILES" ]; then
    BUILD_DIR="_build/precommit-check"
    rm -rf "$BUILD_DIR"
    if python3 -m sphinx -b dummy -W "$(git rev-parse --show-toplevel)/source" "$BUILD_DIR" 2>/tmp/sphinx_err.txt 1>/dev/null; then
        echo -e "\033[0;32m✓ RST 语法检查通过，无警告。\033[0m"
    else
        echo -e "\033[0;31m✗ RST 语法错误！请修复: \033[0m"
        cat /tmp/sphinx_err.txt
        EXIT_CODE=1
    fi
    rm -rf "$BUILD_DIR"
else
    echo -e "\033[0;32m✓ 没有 RST 文件需要检查。\033[0m"
fi

# ------- CJK 间距检查（可选告警，不阻塞提交） -------

if [ -n "$RST_FILES" ]; then
    SCRIPT_DIR="$(git rev-parse --show-toplevel)/scripts"
    if python3 "$SCRIPT_DIR/check-cjk-spacing.py" 2>&1 | grep -q '⚠\|共'; then
        echo -e "\033[1;33m=== CJK 间距告警（不影响提交） ===\033[0m"
        python3 "$SCRIPT_DIR/check-cjk-spacing.py" 2>&1 | grep '⚠\|共'
        echo -e "\033[1;33m  运行 python3 scripts/check-cjk-spacing.py --fix 自动修复\033[0m"
    fi
fi

# ------- 汇总结果 -------

if [ $EXIT_CODE -ne 0 ]; then
    echo -e "\033[0;31m✗ Pre-Commit 检查未通过，提交已中止。\033[0m"
    exit $EXIT_CODE
fi

echo -e "\033[0;32m✓ Pre-Commit 全部检查通过。\033[0m"
exit 0
