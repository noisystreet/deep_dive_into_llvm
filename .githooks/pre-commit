#!/bin/bash
# Git Pre-Commit Hook
# 启用方式: git config --local core.hooksPath .githooks
#
# 检查内容:
#   1. C/C++ 代码格式（clang-format）
#   2. RST 文档语法（Sphinx）

EXIT_CODE=0

# ------- C/C++ 格式检查 (clang-format) -------

echo "=== Pre-Commit: 检查 C/C++ 代码格式 ==="

STAGED_CC_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cpp|h|hpp)$' || true)

if [ -n "$STAGED_CC_FILES" ]; then
    if ! command -v clang-format &>/dev/null; then
        echo "⚠  clang-format 未安装，跳过 C/C++ 格式检查。"
        echo "   安装: sudo apt install clang-format 或 pip install clang-format"
    else
        HAS_ERROR=0
        for f in $STAGED_CC_FILES; do
            # 将暂存的文件内容导出，检查格式
            staged_content=$(git show :"$f")
            formatted=$(echo "$staged_content" | clang-format --style=file 2>/dev/null)
            if [ $? -ne 0 ]; then
                echo -e "\033[0;31m✗ clang-format 解析失败: $f\033[0m"
                HAS_ERROR=1
                continue
            fi
            if [ "$staged_content" != "$formatted" ]; then
                echo -e "\033[0;31m✗ 格式错误: $f\033[0m"
                # 显示差异
                diff -u <(echo "$staged_content") <(echo "$formatted") 2>/dev/null | head -40
                echo -e "\033[1;33m  运行 clang-format -i $f 自动修复\033[0m"
                HAS_ERROR=1
            fi
        done
        if [ $HAS_ERROR -ne 0 ]; then
            EXIT_CODE=1
        else
            echo -e "\033[0;32m✓ 所有 C/C++ 文件格式正确\033[0m"
        fi
    fi
else
    echo -e "\033[0;32m✓ 没有 C/C++ 文件需要检查\033[0m"
fi

# ------- RST 语法检查 -------

echo "=== Pre-Commit: 检查 RST 文档语法 ==="
bash scripts/precommit-check.sh --hook
RST_EXIT=$?

if [ $RST_EXIT -ne 0 ]; then
    EXIT_CODE=$RST_EXIT
fi

# ------- 汇总结果 -------

if [ $EXIT_CODE -ne 0 ]; then
    echo -e "\033[0;31m✗ Pre-Commit 检查未通过，提交已中止。\033[0m"
    exit $EXIT_CODE
fi

echo -e "\033[0;32m✓ Pre-Commit 全部检查通过。\033[0m"
exit 0
